# Sonicraft Authentication Environment Variables

# Original Login Backend Endpoint (Port 5050)
NEXT_PUBLIC_LOGIN_URL="http://localhost:5050/api/auth/login"
AUTH_API_URL="http://localhost:5050/api/auth/login"

# HMAC Session Secret (generate with: openssl rand -hex 32)
SESSION_SECRET="sonicraft-dev-secret-do-not-use-in-production"
